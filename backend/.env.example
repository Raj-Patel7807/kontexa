# Backend Environment Settings
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database Connection
# Local development
DATABASE_URL=postgresql+asyncpg://kontexa:kontexa_pass@localhost:5432/kontexa_db

# Aiven PostgreSQL
# DATABASE_URL=postgresql+asyncpg://avnadmin:<PASSWORD>@<HOST>:<PORT>/defaultdb?ssl=require

# Aiven CA certificate (optional depending on your SSL configuration)
DATABASE_CA_CERT=

# SSL mode
# Local PostgreSQL: disable
# Aiven: require
DATABASE_SSL_MODE=disable

# Connection Pool
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Connection
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins
CORS_ORIGINS=["http://localhost:3000"]
